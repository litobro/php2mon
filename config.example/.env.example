# Use only URL-safe characters (e.g. openssl rand -hex 24); the value is embedded in DATABASE_URL unencoded.
POSTGRES_PASSWORD=change-me
CONFIG_DIR=./config.example
TLS_CN=localhost

# Dashboard tunnel (Cloudflare). Leave unset until the tunnel exists.
# Enabling requires BOTH of these in the private .env:
#   COMPOSE_PROFILES=tunnel
#   TUNNEL_TOKEN=<token from the Cloudflare Zero Trust tunnel>
# With COMPOSE_PROFILES=tunnel present, `docker compose up -d --remove-orphans`
# keeps cloudflared running; if the line is removed, the tunnel container is stopped.
