[Unit]
Description=php2mon git and image sync
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=4min
ExecStartPre=-/bin/sh -c 'iptables -C DOCKER-USER -d 169.254.169.254 -j DROP 2>/dev/null || iptables -I DOCKER-USER -d 169.254.169.254 -j DROP'
ExecStart=/bin/sh /opt/php2mon/deploy/sync.sh
